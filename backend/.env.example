# انسخ هذا الملف إلى .env (لا ترفع .env إلى git أبداً)

# اتصال قاعدة البيانات
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# سر توقيع رموز الدخول — إلزامي، 32 حرفاً عشوائياً فأكثر. لتوليده:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# مدة صلاحية الجلسة بالدقائق (480 = 8 ساعات)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# المدير الأول: يُنشأ تلقائياً عند الإقلاع فقط إن كان جدول المستخدمين فارغاً
ADMIN_EMAIL=
ADMIN_PASSWORD=

# أصول (origins) مسموحة للتطوير من خادم آخر، مفصولة بفواصل. اتركه فارغاً إن كانت
# الواجهة تُخدَّم من نفس الخادم (الوضع الافتراضي). لا يُسمح بـ *
CORS_ORIGINS=

# 1 لإظهار تفاصيل الأخطاء الداخلية أثناء التطوير فقط
DEBUG=
